# Backend Environment Variables

# MySQL Database
MYSQL_SERVER=127.0.0.1
MYSQL_USER=root
MYSQL_PASSWORD=12345678
MYSQL_DB=szlab_appoint
MYSQL_PORT=3306

# Optional: override full connection string
# DATABASE_URL=mysql+aiomysql://root:12345678@127.0.0.1:3306/szlab_appoint

# Internal employee module (former security-server). Endpoints are now
# served in-process at /security-api/api/*; these two booleans only let
# ops toggle the integration on/off.
SECURITY_SERVER_ENABLED=true
SECURITY_SERVER_PROJECT_SYNC_ENABLED=true

# JWT Security
SECRET_KEY=your-secret-key-change-this-in-production-please
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# CORS Origins (comma separated)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# First Superuser
FIRST_SUPERUSER=admin@nemo.local
FIRST_SUPERUSER_PASSWORD=admin
